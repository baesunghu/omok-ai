# NAPS 11x11 gomoku -- private record repo (2026-10-09).
# Whitelist only: this folder also holds the 3x3 / 5x5 / clean_3x3 projects, which stay
# out of this repository entirely. Everything is ignored unless re-included below.
/*
!/.gitignore
!/README.md
!/10x10/
!/cpp_mcts/
!/manual/

# --- 10x10: source, docs, problems, web board only ---
/10x10/**
!/10x10/**/
!/10x10/*.py
!/10x10/*.md
!/10x10/docs/**
!/10x10/hlt/web/*.py
!/10x10/hlt/web/*.html
!/10x10/tactical_problems/*.json
# never: weights, buffers, logs, binaries, old backup folders
/10x10/model/
/10x10/backup_*/
/10x10/**/__pycache__/
/10x10/scratch*/

# --- cpp_mcts: the engine sources the 11x11 run actually uses ---
/cpp_mcts/*
!/cpp_mcts/mcts_core_solver.cpp
!/cpp_mcts/build_mcts_core_solver.bat
!/cpp_mcts/deterministic_play_core_fast_deploy.cpp

# --- manual: sources and build scripts, not the generated docx/pdf ---
/manual/*
!/manual/*.html
!/manual/*.css
!/manual/build_*.py
/manual/_*.html
!/LICENSE

# --- 2026-10-28: v2 / v3 (Gumbel + CATFISH) / 15x15 sources, README figures, festival videos' HTML sources ---
!/assets/
!/11x11_v2/
/11x11_v2/*
!/11x11_v2/*.py
!/11x11_v2/v3/
/11x11_v2/v3/*
!/11x11_v2/v3/*.py
!/11x11_v2/v3/cpp/
/11x11_v2/v3/cpp/*
!/11x11_v2/v3/cpp/*.cpp
!/11x11_v2/v3/cpp/*.bat
!/11x11_v2/v3/cpp/*.py
!/15x15/
/15x15/*
!/15x15/*.py
!/festival/
/festival/*
!/festival/intro_html/
/festival/intro_html/*
!/festival/intro_html/intro.html
!/festival/intro_html/summary.html
!/festival/intro_html/data/
!/festival/render_intro_video.py
!/festival/render_summary.py

# never: backups, generated game viewers (visitor games)
*.bak*
*.reverted_*
/10x10/hlt/web/games_viewer.html
/10x10/hlt/web/watch_list.html
/10x10/docs/*.pdf
